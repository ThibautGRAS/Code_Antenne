"""
Fonctions de rappel pré-implémentées pour déployer facilement des applications basées les systèmes Megamicros.
"""


from os import makedirs
from datetime import datetime
#from h5py import File
import numpy as np
from .core import osp


class Callbacks():
    
    data = None

    def receive(self, *args, **kwargs):
        self.call(**kwargs)


class PrintData(Callbacks):
    """Classe test pour l'ajout de callbacks"""

    def call(self, data):
        print(data)


